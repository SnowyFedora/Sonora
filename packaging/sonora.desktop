[Desktop Entry]
Type=Application
Name=Sonora
GenericName=Music Player
Comment=Lightweight music player and sound library
Exec=sonora %F
Icon=audio-headphones
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;soundboard;playlist;audio;
StartupNotify=true
MimeType=audio/mpeg;audio/mp3;audio/flac;audio/ogg;audio/opus;audio/wav;audio/x-m4a;inode/directory;
